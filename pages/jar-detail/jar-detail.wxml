<view class="page {{nightClass}}" style="background: {{bg}};">
  <view class="head inner">
    <text class="nav-back" bindtap="goBack">‹ 返回</text>
    <text class="big">储蓄明细</text>
  </view>

  <scroll-view scroll-y class="scroll">
    <view class="card">
      <text class="title-sm">主动存钱</text>
      <view wx:if="{{activeLogs.length===0}}" class="exp-empty">还没有主动存钱记录</view>
      <view wx:for="{{activeLogs}}" wx:key="ts" class="exp-row">
        <text>{{item.date}}</text>
        <text class="green">+¥{{item.amount}}</text>
      </view>
    </view>

    <view class="card" style="margin-top:24rpx;">
      <text class="title-sm">每日固化结余（历史）</text>
      <view wx:if="{{carryRows.length===0}}" class="exp-empty">暂无历史记录</view>
      <view wx:for="{{carryRows}}" wx:key="date" class="exp-row">
        <view class="mid">
          <text class="cat">{{item.date}}</text>
          <text class="dt">{{item.label}}</text>
        </view>
        <text class="am {{item.diff>=0?'pos':'neg'}}">{{item.diff>=0?'+':''}}¥{{item.diff}}</text>
      </view>
    </view>
  </scroll-view>
</view>
