.title-sm { font-size: 30rpx; font-weight: 700; margin-bottom: 18rpx; display: block; }
.inp { flex: 1; text-align: right; margin: 0 16rpx; font-size: 30rpx; color: var(--text); }
.unit { font-size: 22rpx; color: var(--text-2); width: 90rpx; text-align: right; }
.tip { display:block; font-size: 22rpx; color: var(--text-2); margin-top: 16rpx; text-align:center; }

.weekrow { display: flex; margin-top: 20rpx; }
.weekrow .wd { flex: 1; text-align: center; font-size: 22rpx; color: var(--text-2); }
.grid { display: flex; flex-wrap: wrap; margin-top: 12rpx; }
.cell {
  width: 14.28%; height: 76rpx; display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; box-sizing: border-box; color: var(--text);
}
.cell.ok { color: #2fd99a; background: rgba(47,217,154,.16); border-radius: 14rpx; }
.cell.bad { color: #ff6b7d; background: rgba(255,107,125,.18); border-radius: 14rpx; }
.cell.today { color: #aab4ff; border: 2rpx solid #aab4ff; border-radius: 14rpx; }
.page.night .cell { color: #eef0ff; }
.page.night .cell.ok { background: rgba(47,217,154,.28); }
.page.night .cell.bad { background: rgba(255,107,125,.28); }
