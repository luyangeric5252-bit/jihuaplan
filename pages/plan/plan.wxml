<view class="page {{nightClass}}" style="background: {{bg}};">
  <view class="head-bar">
    <text class="h-title">计划经济</text>
    <text class="h-sub">我的节流计划</text>
  </view>

  <scroll-view scroll-y class="scroll">
    <!-- 日计划 -->
    <view class="card tint blue">
      <view class="lbl">日计划（{{todayType}}）· 今日预算</view>
      <view class="val">¥{{dayBudget}}</view>
      <view class="sub">工作日 ¥{{workdayHint}} / 非工作日 ¥{{restdayHint}}</view>
    </view>

    <!-- 周计划 -->
    <view class="card tint green">
      <view class="lbl">周计划 · 每周预算（自动）</view>
      <view class="val">¥{{weekBudget}}</view>
      <view class="sub">本周已花 ¥{{ws}} · {{weekDiff<0? '赤字 ¥'+weekDiff : '结余 ¥'+weekDiff}}</view>
    </view>

    <!-- 月计划 -->
    <view class="card tint amber">
      <view class="lbl">月计划 · 每月预算（自动）</view>
      <view class="val">¥{{monthBudget}}</view>
      <view class="sub">本月已花 ¥{{ms}} · {{monthDiff<0? '赤字 ¥'+monthDiff : '结余 ¥'+monthDiff}}</view>
    </view>

    <!-- 本月打卡日历 -->
    <view class="card">
      <text class="k" style="font-size:26rpx;color:var(--text-2);font-weight:700;display:block;margin-bottom:20rpx;">本月打卡日历</text>
      <view class="cal-head">
        <text>日</text><text>一</text><text>二</text><text>三</text><text>四</text><text>五</text><text>六</text>
      </view>
      <view class="cal">
        <view wx:for="{{cells}}" wx:key="day" class="{{item.cls}}" data-day="{{item.day}}" data-ds="{{item.ds}}" bindtap="onCellTap">
          <text class="d" wx:if="{{item.day>0}}">{{item.day}}</text>
          <text class="mk" wx:if="{{item.mk}}">{{item.mk}}</text>
        </view>
      </view>
      <view class="cal-legend">
        <view class="li"><view class="sw ok"></view>达标</view>
        <view class="li"><view class="sw bad"></view>超支</view>
        <view class="li"><view class="sw none"></view>未记</view>
      </view>
    </view>

    <view class="btn ghost" bindtap="openPlan">＋ 制定计划</view>
  </scroll-view>

  <!-- 记一笔弹框（补记/记一笔共用） -->
  <expense-sheet id="expSheet" show="{{expShow}}" night="{{nightClass==='night'}}" presetDate="{{expDate}}" bind:close="closeExp" bind:saved="onExpSaved"/>

  <!-- 制定计划弹框 -->
  <plan-sheet id="planSheet" show="{{planShow}}" night="{{nightClass==='night'}}" bind:close="closePlan" bind:saved="onPlanSaved"/>
</view>
