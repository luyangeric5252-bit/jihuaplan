<view class="page {{nightClass}}" style="background: {{bg}};">
  <view class="head-bar">
    <text class="h-title">我的储蓄</text>
    <text class="h-sub">计划储蓄罐</text>
  </view>

  <scroll-view scroll-y class="scroll">
    <!-- 储蓄罐 -->
    <view class="jar {{jarCls}}">
      <view class="fill" style="height: {{pct}}%;"></view>
      <view class="float">
        <text class="n">¥{{net}}</text>
        <text class="s">储蓄罐（主动存钱 + 今日剩余）</text>
      </view>
      <view wx:for="{{coins}}" wx:key="id" class="coin" style="left: {{item.x}}%;">{{item.label}}</view>
    </view>

    <!-- 储蓄概览卡片 + 进度 -->
    <view class="card">
      <view class="row">
        <text class="k">主动存钱</text>
        <text class="v green">+¥{{savedActive}}</text>
      </view>
      <view class="row" style="margin-top:18rpx;">
        <text class="k">今日剩余可花</text>
        <text class="v {{dayDiff<0?'red':''}}">{{dayDiff<0?'-':'+'}}¥{{dayDiff}}</text>
      </view>
      <view class="row" style="margin-top:18rpx;">
        <text class="k">储蓄目标</text>
        <text class="v">¥{{goal}}</text>
      </view>
    </view>
    <view class="progress"><view class="bar" style="width: {{pct}}%;"></view></view>
    <view class="prog-tip">已攒 {{net0}} / {{goal}} · {{reached ? '🎉 已达成' : '继续努力'}}</view>

    <!-- 操作按钮（明细 / 统计 用淡色大按钮，主动存钱主色，清空危险） -->
    <view class="btn-ghost" style="margin-top:26rpx;" bindtap="openDetail">明细</view>
    <view class="btn-ghost" style="margin-top:16rpx;" bindtap="openStats">统计</view>
    <view class="btn-primary" style="margin-top:16rpx;" bindtap="openSave">＋ 主动存钱</view>
    <view class="btn-ghost danger" style="margin-top:16rpx;" bindtap="doReset">清空储蓄罐</view>
  </scroll-view>

  <!-- 主动存钱弹框（输入金额） -->
  <save-sheet show="{{saveShow}}" night="{{nightClass==='night'}}" bind:close="closeSave" bind:saved="onSaveSaved"/>

  <expense-sheet id="expSheet" show="{{expShow}}" night="{{nightClass==='night'}}" bind:close="closeExp" bind:saved="onExpSaved"/>
</view>
