.page { min-height: 100vh; }
.head { padding: 24rpx 36rpx 0; }
.title { font-size: 40rpx; font-weight: 800; }
.scroll { padding: 24rpx 36rpx 160rpx; }
.det { font-size: 28rpx; color: var(--blue); font-weight: 600; }
.link:active { opacity: .7; }
.btn-ghost {
  background: rgba(0,0,0,.04); color: var(--text-2); font-weight: 600; border-radius: 28rpx; padding: 24rpx; text-align: center;
}
.tip { font-size: 24rpx; color: var(--text-2); }

.sheet-head { display: flex; align-items: center; justify-content: space-between; }
.sheet-title { font-size: 32rpx; font-weight: 800; }
.sheet-close { font-size: 28rpx; color: var(--blue); }
.log-row { display: flex; justify-content: space-between; padding: 10rpx 0; font-size: 28rpx; border-bottom: 1rpx solid rgba(0,0,0,.05); }
.log-row .green { color: var(--green); font-weight: 600; }
.log-row .dt { color: var(--text-2); font-size: 24rpx; }
