.det { font-size: 28rpx; color: var(--blue); font-weight: 700; margin-left: auto; }
.page.night .det { color: #aab4ff; }
.link:active { opacity: .7; }

.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.sheet-title { font-size: 34rpx; font-weight: 800; }
.sheet-close { font-size: 28rpx; color: var(--blue); font-weight: 600; }
.page.night .sheet-close { color: #aab4ff; }
.log-row { display: flex; justify-content: space-between; padding: 14rpx 0; font-size: 28rpx; border-bottom: 1rpx solid var(--line); }
.log-row .green { color: var(--green); font-weight: 700; }
.log-row .dt { color: var(--text-2); font-size: 24rpx; }
