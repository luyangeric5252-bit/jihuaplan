<view class="page {{nightClass}}" style="background: {{bg}};">
  <view class="head"><text class="title">皮肤</text></view>

  <scroll-view scroll-y class="scroll">
    <text class="tip">全部皮肤免费 · 无需内购</text>
    <view class="skin-grid">
      <view wx:for="{{skins}}" wx:key="id" class="skin {{item.id===selected?'sel':''}}" bindtap="pick" data-id="{{item.id}}">
        <view class="prev" style="background: {{item.bg}};">
          <view class="mc"></view>
          <text class="nm">{{item.name}}</text>
        </view>
        <view class="pr free">免费</view>
        <view wx:if="{{item.id===selected}}" class="check">✓</view>
      </view>
    </view>
  </scroll-view>
</view>
