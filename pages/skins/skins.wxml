<view class="page {{nightClass}}" style="background: linear-gradient(160deg, {{bg[0]}}, {{bg[1]}});">
  <view class="head"><text class="title">皮肤</text></view>

  <scroll-view scroll-y class="scroll">
    <text class="tip">全部皮肤免费 · 无需内购</text>
    <view class="grid2">
      <view wx:for="{{skins}}" wx:key="id" class="item {{item.id===selected?'on':''}}" bindtap="pick" data-id="{{item.id}}">
        <view class="swatch" style="background: linear-gradient(160deg, {{item.g[0]}}, {{item.g[1]}});">
          <view wx:if="{{item.id===selected}}" class="check">✓</view>
        </view>
        <text class="name {{item.id===selected?'on':''}}">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>
</view>
