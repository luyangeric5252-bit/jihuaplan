.page { min-height: 100vh; }
.head { padding: 24rpx 36rpx 0; }
.title { font-size: 40rpx; font-weight: 800; }
.scroll { padding: 24rpx 36rpx 160rpx; }
.tip { display:block; font-size: 22rpx; color: var(--text-2); margin-bottom: 24rpx; }
.grid2 { display: flex; flex-wrap: wrap; gap: 28rpx; }
.item { width: calc(50% - 14rpx); }
.swatch { height: 160rpx; border-radius: 24rpx; position: relative; box-shadow: 0 6rpx 20rpx rgba(0,0,0,.08); }
.item.on .swatch { outline: 5rpx solid #5b6cff; outline-offset: 2rpx; }
.check {
  position: absolute; right: 16rpx; bottom: 16rpx; width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #5b6cff; color: #fff; font-size: 28rpx; text-align: center; line-height: 44rpx;
}
.name { display: block; font-size: 28rpx; font-weight: 600; margin-top: 14rpx; text-align: center; }
