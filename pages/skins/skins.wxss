.tip { display:block; font-size: 22rpx; color: var(--text-2); margin-bottom: 24rpx; }
.grid2 { display: flex; flex-wrap: wrap; gap: 28rpx; }
.item { width: calc(50% - 14rpx); }
.swatch { height: 168rpx; border-radius: 28rpx; position: relative; box-shadow: 0 6rpx 20rpx rgba(0,0,0,.08); border: 5rpx solid transparent; box-sizing: border-box; }
.item.on .swatch { border-color: #5b6cff; }
.check {
  position: absolute; right: 12rpx; bottom: 12rpx; width: 44rpx; height: 44rpx; border-radius: 50%;
  background: #5b6cff; color: #fff; font-size: 24rpx; text-align: center; line-height: 44rpx;
}
.name { display: block; font-size: 28rpx; font-weight: 600; margin-top: 14rpx; text-align: center; color: var(--text); }
.name.on { color: #5b6cff; font-weight: 700; }
