<view class="page {{nightClass}}" style="background: {{bg}};">
  <!-- 头部导航条：标题左上、副标题(当天日期)居中、与胶囊同行 -->
  <view class="head-bar">
    <text class="h-title">今天的花销</text>
    <text class="h-sub">{{dateStr}} 周{{weekday}}</text>
  </view>

  <scroll-view scroll-y class="scroll">
    <!-- 综合卡片：已花 / 日预算 / 剩余可花 + 进度条 + 结余 pill -->
    <view class="card">
      <view class="row">
        <text class="k">已花</text>
        <text class="v">¥{{ds}}</text>
      </view>
      <view class="row" style="margin-top:18rpx;">
        <text class="k">日预算</text>
        <text class="v">{{dayBudgetStr}}</text>
      </view>
      <view class="row" style="margin-top:18rpx;">
        <text class="k">剩余可花</text>
        <text class="v {{dayDiff<0?'red':''}}">{{dayDiff<0?'-':'+¥'}}{{dayStr}}</text>
      </view>
      <view class="progress {{dayDiff<0?'over':''}}">
        <view class="bar" style="width:{{dayDiff<0?100:ds>0?(ds*100)+'%':'0%'}}"></view>
      </view>
      <view style="margin-top:18rpx;">
        <view class="pill {{dayDiff<0?'red':'green'}}">
          {{dayDiff<0? '⚠ 今日赤字 ¥'+dayStr : '✓ 今日结余 ¥'+dayStr}}
        </view>
      </view>
    </view>

    <!-- 本周 / 本月 -->
    <view class="card">
      <view class="row">
        <text class="k">本周（一~日）</text>
        <text class="v {{weekDiff<0?'red':''}}">{{weekDiff<0?'-':'+¥'}}{{weekStr}}</text>
      </view>
      <view class="sub">预算剩余（周预算−本周已花）</view>
      <view class="divider"></view>
      <view class="row" style="margin-top:18rpx;">
        <text class="k">本月</text>
        <text class="v {{monthDiff<0?'red':''}}">{{weekDiff<0?'-':'+¥'}}{{monthStr}}</text>
      </view>
      <view class="sub">预算剩余（月预算−本月已花）</view>
    </view>

    <!-- 今日消费 chips -->
    <view class="card">
      <text class="k" style="font-size:26rpx;color:var(--text-2);font-weight:700;display:block;margin-bottom:18rpx;">今日消费</text>
      <block wx:if="{{chips.length}}">
        <view wx:for="{{chips}}" wx:key="index" class="chip">
          <text class="e">{{item.emoji}}</text>
          <text>{{item.cat}} ¥{{item.amount}}</text>
        </view>
      </block>
      <view wx:else class="empty">今天还没记账，点中间 ＋ 记一笔</view>
    </view>
  </scroll-view>

  <expense-sheet id="expSheet" show="{{expShow}}" night="{{nightClass==='night'}}" bind:close="closeExp" bind:saved="onExpSaved"/>
</view>
