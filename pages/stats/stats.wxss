.title-sm { font-size: 30rpx; font-weight: 700; display: block; margin-bottom: 18rpx; }

/* 内页 head：返回按钮左上角，与胶囊同一行 */
.head.inner {
  flex-direction: row;
  align-items: center;
  height: 88rpx;
  padding: calc(env(safe-area-inset-top) + 8rpx) 36rpx 0;
  gap: 16rpx;
}
.head.inner .title { font-size: 36rpx; font-weight: 800; letter-spacing: .5rpx; }
.nav-back { font-size: 36rpx; font-weight: 700; color: var(--blue); }
.page.night .nav-back { color: #aab4ff; }
.lg-row { display: flex; align-items: center; padding: 12rpx 0; }
.dot { width: 24rpx; height: 24rpx; border-radius: 50%; margin-right: 16rpx; }
.lg-k { font-size: 28rpx; }
.lg-v { margin-left: auto; font-size: 28rpx; color: var(--text-2); }

.bar { display: flex; align-items: flex-end; gap: 20rpx; height: 280rpx; padding: 48rpx 4rpx 56rpx; }
.b { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; position: relative; }
.bv { position: absolute; top: 0; font-size: 20rpx; font-weight: 800; color: var(--text); white-space: nowrap; }
.col { width: 100%; background: linear-gradient(180deg, #5b6cff, #8b97ff); border-radius: 10rpx; min-height: 8rpx; }
.bw { font-size: 22rpx; font-weight: 800; color: var(--text); margin-top: 12rpx; }

.exp { margin-top: 16rpx; }
.exp-row { display: flex; justify-content: space-between; padding: 14rpx 0; font-size: 28rpx; border-bottom: 1rpx solid var(--line); }
.exp-row .green { color: var(--green); font-weight: 700; }
.exp-row .dt { color: var(--text-2); font-size: 24rpx; }
