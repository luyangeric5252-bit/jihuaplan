/* 通用居中弹窗（页面中间弹出 + 缩放淡入动画） */
.sheet-mask {
  position: fixed; inset: 0;
  background: rgba(20,20,40,.45);
  z-index: 200;
  display: flex; align-items: center; justify-content: center;
  opacity: 0; visibility: hidden;
  transition: opacity .25s ease, visibility .25s ease;
}
.sheet-mask.show { opacity: 1; visibility: visible; }

.sheet {
  width: 84%; max-width: 640rpx;
  border-radius: 44rpx;
  padding: 40rpx 32rpx;
  background: var(--card-bg, #fff);
  box-shadow: 0 24rpx 80rpx rgba(0,0,0,.2);
  transform: scale(.86) translateY(20rpx);
  opacity: 0;
  transition: transform .28s cubic-bezier(.22,1,.36,1), opacity .28s ease;
}
.sheet-mask.show .sheet {
  transform: scale(1) translateY(0);
  opacity: 1;
}

/* 暗夜紫：深色玻璃 + 亮字 */
.sheet.night {
  background: rgba(28,28,46,.96);
  color: #eef0ff;
  border: 1rpx solid rgba(255,255,255,.16);
}

/* 顶部小横线（居中弹框里作为装饰） */
.grip { width: 76rpx; height: 10rpx; border-radius: 6rpx; background: rgba(120,120,150,.4); margin: 0 auto 20rpx; }
.sheet.night .grip { background: rgba(255,255,255,.35); }
