/* 通用居中弹窗（页面中间弹出 + 缩放淡入动画） */
.sheet-mask {
  position: fixed; inset: 0;
  background: rgba(20,20,40,.45);
  z-index: 200;
  display: flex; align-items: center; justify-content: center;
  animation: maskIn .25s ease;
}

.sheet {
  width: 84%; max-width: 640rpx;
  border-radius: 44rpx;
  padding: 40rpx 32rpx;
  background: var(--card-bg, #fff);
  box-shadow: 0 24rpx 80rpx rgba(0,0,0,.2);
  animation: popIn .28s cubic-bezier(.22,1,.36,1);
}

/* 暗夜紫：深色玻璃 + 亮字 */
.sheet.night {
  background: rgba(28,28,46,.96);
  color: #eef0ff;
  border: 1rpx solid rgba(255,255,255,.16);
}

/* 顶部小横线（居中弹框里作为装饰） */
.grip { width: 76rpx; height: 10rpx; border-radius: 6rpx; background: rgba(120,120,150,.4); margin: 0 auto 20rpx; }
.sheet.night .grip { background: rgba(255,255,255,.35); }

@keyframes maskIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
@keyframes popIn {
  from { opacity: 0; transform: scale(.86) translateY(20rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}
