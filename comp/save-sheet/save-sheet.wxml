<sheet show="{{show}}" night="{{night}}" bind:close="onClose">
  <view class="head-row">
    <text class="ttl">主动存钱</text>
    <view class="pill brand">存入储蓄罐</view>
  </view>
  <view class="amount">
    <text class="cur">¥</text>
    <input class="amt" type="digit" value="{{amount}}" bindinput="onAmt" placeholder="" focus="{{show}}"/>
  </view>
  <view class="btn-primary" style="margin-top:32rpx;" bindtap="save">存入</view>
  <view class="btn-ghost" style="margin-top:16rpx;" bindtap="onClose">取消</view>
</sheet>
