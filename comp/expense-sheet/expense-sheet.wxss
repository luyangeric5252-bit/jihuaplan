.head-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.ttl { font-size: 34rpx; font-weight: 800; }
.pill.brand { background: rgba(91,108,255,.16); color: #5b6cff; font-size: 22rpx; font-weight: 800; padding: 6rpx 18rpx; border-radius: 999rpx; }

.amount { font-size: 64rpx; font-weight: 800; text-align: center; margin: 8rpx 0 20rpx; display: flex; align-items: center; justify-content: center; }
.amount .cur { font-size: 48rpx; margin-right: 8rpx; }
.amount .amt { font-size: 64rpx; font-weight: 800; text-align: center; min-width: 200rpx; }

.cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin: 8rpx 0 20rpx; }
.cat { padding: 20rpx 8rpx; border-radius: 24rpx; background: rgba(255,255,255,.7); border: 1rpx solid rgba(255,255,255,.8); text-align: center; font-size: 24rpx; font-weight: 800; color: #1c1c2e; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.cat .e { font-size: 36rpx; }
.cat.on { background: linear-gradient(135deg, #5b6cff, #8b97ff); color: #fff; }
.sheet.night .cat { background: rgba(255,255,255,.1); color: #eef0ff; border-color: rgba(255,255,255,.2); }

.field { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0; border-bottom: 1rpx solid var(--line, rgba(0,0,0,.06)); }
.field .k { font-size: 28rpx; color: var(--text-2, #7a7a92); font-weight: 700; }
.field .v { font-size: 30rpx; font-weight: 800; }
.picker-box { font-size: 28rpx; color: #5b6cff; padding: 16rpx 0; }
.note { font-size: 28rpx; width: 100%; text-align: left; }

/* 选“其他”时出现的自定义类型输入框 */
.custom-wrap { margin: 4rpx 0 20rpx; padding: 20rpx 24rpx; border-radius: 24rpx; background: rgba(255,255,255,.6); border: 1rpx solid rgba(255,255,255,.8); display: flex; align-items: center; gap: 16rpx; }
.sheet.night .custom-wrap { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.2); }
.cu-label { font-size: 26rpx; font-weight: 800; color: #5b6cff; flex-shrink: 0; }
.cu-input { flex: 1; font-size: 28rpx; font-weight: 700; color: var(--text, #1c1c2e); }

.btn-primary { background: linear-gradient(135deg, #5b6cff, #8b97ff); color: #fff; font-weight: 800; border-radius: 28rpx; padding: 30rpx; text-align: center; font-size: 32rpx; box-shadow: 0 8rpx 22rpx rgba(91,108,255,.35); }
.btn-ghost { background: rgba(0,0,0,.04); color: var(--text-2, #7a7a92); font-weight: 700; border-radius: 28rpx; padding: 26rpx; text-align: center; font-size: 30rpx; }
.sheet.night .btn-ghost { background: rgba(255,255,255,.1); color: #aab4ff; }
