/* 悬浮圆角 tabBar（更通透，减少与背景的分层感） */
.tabbar {
  position: fixed; left: 22rpx; right: 22rpx;
  bottom: calc(env(safe-area-inset-bottom) + 16rpx);
  height: 140rpx;
  background: rgba(255,255,255,.28);
  border: 1rpx solid rgba(255,255,255,.45);
  border-radius: 52rpx;
  display: flex; align-items: center; justify-content: space-around;
  box-shadow: 0 24rpx 60rpx rgba(40,44,90,.12);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  padding: 0 12rpx; z-index: 50;
}
.tabbar.night { background: rgba(20,20,35,.38); border-color: rgba(255,255,255,.12); box-shadow: 0 24rpx 60rpx rgba(0,0,0,.35); }

.tab {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  font-size: 20rpx; font-weight: 800; color: #7a7a92; flex: 1;
}
.tab.on { color: #5b6cff; }
.tabbar.night .tab { color: #a9acc8; }
.tabbar.night .tab.on { color: #aab4ff; }
.tab .ic { width: 46rpx; height: 46rpx; display: block; }

.tab.add .ic-plus {
  color: #fff; background: linear-gradient(135deg,#5b6cff,#8b97ff);
  width: 104rpx; height: 104rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; font-size: 60rpx; font-weight: 300;
  border: 1rpx solid rgba(255,255,255,.7);
  box-shadow: 0 16rpx 40rpx rgba(91,108,255,.45);
  margin-top: -44rpx;
}
