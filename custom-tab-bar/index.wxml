<view class="tabbar {{night?'night':''}}">
  <view class="tab {{selected==='today'?'on':''}}" data-go="today" bindtap="onTap">
    <view class="ic">
      <svg viewBox="0 0 24 24" width="46rpx" height="46rpx" fill="currentColor"><path d="M12 3.2 3 10.5V21h6v-6h6v6h6V10.5z"/></svg>
    </view>
    <text>今天</text>
  </view>
  <view class="tab {{selected==='plan'?'on':''}}" data-go="plan" bindtap="onTap">
    <view class="ic">
      <svg viewBox="0 0 24 24" width="46rpx" height="46rpx" fill="currentColor"><path d="M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 4v2h14V8zm0 4v2h6v-2zm0 4v2h6v-2z"/></svg>
    </view>
    <text>计划</text>
  </view>
  <view class="tab add" data-go="record" bindtap="onTap">
    <view class="ic">＋</view>
  </view>
  <view class="tab {{selected==='jar'?'on':''}}" data-go="jar" bindtap="onTap">
    <view class="ic">
      <svg viewBox="0 0 24 24" width="46rpx" height="46rpx" fill="currentColor"><path d="M3 7h18a1 1 0 0 1 1 1v3a4 4 0 0 1-3.3 3.94A3 3 0 0 1 15 18.6V20a1 1 0 0 1-2 .5L11.5 20 11 20.5a1 1 0 0 1-2-.5v-1.4a3 3 0 0 1-3.7-3.66A4 4 0 0 1 2 11V8a1 1 0 0 1 1-1zm1.2 3.2a4 4 0 0 0 7.8 1.4 4 4 0 0 0 7.8-1.4z"/></svg>
    </view>
    <text>储蓄罐</text>
  </view>
  <view class="tab {{selected==='skins'?'on':''}}" data-go="skins" bindtap="onTap">
    <view class="ic">
      <svg viewBox="0 0 24 24" width="46rpx" height="46rpx" fill="currentColor"><path d="M12 3a9 9 0 0 0 0 18c1 0 1.6-.8 1.6-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.1 0-.9.7-1.6 1.6-1.6H16a5 5 0 0 0 5-5c0-3.9-3.6-7.4-8-7.4zM9.5 9.2a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6zm5 0a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6z"/></svg>
    </view>
    <text>皮肤</text>
  </view>
</view>
