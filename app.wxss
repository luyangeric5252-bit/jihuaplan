/* 计划经济 v2.0 全局样式（高保真，对应 HTML 原型） */
page {
  --card-bg: rgba(255,255,255,.42);
  --text: #1c1c2e;
  --text-2: #8a8aa0;
  --red: #ff5b6e;
  --green: #0f8f63;
  --blue: #5b6cff;
  --gold: #9a6a00;
  --line: rgba(0,0,0,.06);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  color: var(--text);
  padding-top: env(safe-area-inset-top);
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* 浅色默认 Aurora 渐变背景；具体页面可在 .page 上覆盖 */
page, page[bg-default] { background: linear-gradient(160deg, #eef1fb 0%, #e6e9f7 100%); }
page.night { background: #1c1c2e; }

/* 暗夜紫变量覆盖 */
page.night {
  --card-bg: rgba(255,255,255,.1);
  --text: #eef0ff;
  --text-2: #a9acc8;
  --line: rgba(255,255,255,.12);
}

/* 页面基础：全屏沉浸（custom 导航栏，状态栏透出页面背景，与背景同色） */
.page { height: 100vh; display: flex; flex-direction: column; box-sizing: border-box; overflow: hidden; }
.head {
  padding: calc(env(safe-area-inset-top) + 16rpx) 36rpx 0;
  display: flex; flex-direction: column; gap: 4rpx;
  flex-shrink: 0;
}
.head .title { font-size: 44rpx; font-weight: 800; letter-spacing: .5rpx; }

/* 顶部导航条：标题左上、副标题居中、右侧槽位（与胶囊同行） */
.head-bar {
  position: relative;
  height: 88rpx;
  padding-top: env(safe-area-inset-top);
  flex-shrink: 0;
  display: flex; align-items: center;
}
.head-bar .h-title {
  position: absolute; left: 36rpx;
  font-size: 40rpx; font-weight: 800; letter-spacing: 1rpx; color: var(--text);
}
.head-bar .h-sub {
  position: absolute; left: 50%; transform: translateX(-50%);
  font-size: 24rpx; font-weight: 700; color: var(--text-2);
}
.head-bar .h-right {
  position: absolute; right: calc(180rpx + 16rpx);
  font-size: 24rpx; font-weight: 800; color: #5b6cff;
  background: rgba(91,108,255,.12); padding: 8rpx 20rpx; border-radius: 22rpx;
}
.page.night .head-bar .h-right { color: #aab4ff; background: rgba(170,180,255,.18); }
.scroll { flex: 1; overflow-y: auto; padding: 40rpx 36rpx calc(180rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }

/* 卡片（毛玻璃 + 阴影，对齐 HTML 原型 .card） */
.card {
  background: var(--card-bg);
  border-radius: 44rpx;
  padding: 32rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 12rpx 36rpx rgba(40,44,90,.12);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 1rpx solid rgba(255,255,255,.7);
}
.page.night .card, page.night .card { background: rgba(255,255,255,.1); border-color: rgba(255,255,255,.16); }

/* 行 */
.row { display: flex; align-items: center; }
.row .k { font-size: 28rpx; color: var(--text-2); font-weight: 600; }
.row .v { margin-left: auto; font-size: 32rpx; font-weight: 800; }
.row .v.red { color: var(--red); }
.row .v.green { color: var(--green); }
.sub { font-size: 22rpx; color: var(--text-2); margin-top: 8rpx; font-weight: 500; }
.divider { height: 1rpx; background: var(--line); margin: 18rpx 0; }

/* pill（对应原型 .pill） */
.pill { display: inline-flex; align-items: center; padding: 10rpx 24rpx; border-radius: 999rpx; font-size: 26rpx; font-weight: 700; }
.pill.red { background: rgba(255,91,110,.16); color: var(--red); }
.pill.green { background: rgba(15,143,99,.14); color: var(--green); }

/* 主按钮（对应原型 .btn） */
.btn-primary {
  background: linear-gradient(135deg, #5b6cff, #8b97ff);
  color: #fff; font-weight: 800; border-radius: 28rpx; padding: 30rpx;
  text-align: center; font-size: 32rpx;
  box-shadow: 0 8rpx 22rpx rgba(91,108,255,.35);
}
.btn-primary:active { opacity: .85; transform: scale(.99); }
.btn-ghost {
  background: rgba(0,0,0,.04); color: var(--text-2); font-weight: 700;
  border-radius: 28rpx; padding: 26rpx; text-align: center; font-size: 30rpx;
}
.page.night .btn-ghost { background: rgba(255,255,255,.1); color: #aab4ff; }

/* 记账中央按钮（tabBar 占位，凸起） */
.fab-wrap { position: fixed; left: 0; right: 0; bottom: calc(env(safe-area-inset-bottom) + 20rpx); display: flex; justify-content: center; z-index: 50; pointer-events: none; }
.fab {
  pointer-events: auto;
  width: 104rpx; height: 104rpx; border-radius: 50%;
  background: linear-gradient(135deg, #5b6cff, #8b97ff);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 60rpx; font-weight: 300;
  box-shadow: 0 8rpx 24rpx rgba(91,108,255,.4);
  margin-bottom: 20rpx;
}
.fab:active { transform: scale(.92); }

/* 弹框（对应原型 .sheet） */
.sheet-mask { position: fixed; inset: 0; background: rgba(20,20,40,.4); z-index: 100; display: flex; align-items: flex-end; }
.sheet {
  width: 100%; border-radius: 36rpx 36rpx 0 0; padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  animation: slideUp .3s cubic-bezier(.22,1,.36,1);
}
@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
.page.night .sheet { background: rgba(28,28,46,.96); color: #eef0ff; border-top: 1rpx solid rgba(255,255,255,.16); }

/* 储蓄罐（对应原型 .jar 三态 + 金币） */
.jar {
  position: relative; height: 380rpx; border-radius: 44rpx; overflow: hidden;
  border: 4rpx solid transparent;
  background:
    linear-gradient(rgba(255,255,255,.3), rgba(255,255,255,.3)) padding-box,
    linear-gradient(135deg,#ffe9a8,#ffd24d,#ffb300,#ffe9a8) border-box;
  box-shadow: inset 0 4rpx 20rpx rgba(91,108,255,.12), 0 0 0 2rpx rgba(255,210,77,.35), 0 12rpx 44rpx rgba(255,190,60,.25);
}
.jar.red {
  background:
    linear-gradient(rgba(255,255,255,.3), rgba(255,255,255,.3)) padding-box,
    linear-gradient(135deg,#ff7a88,#ff5b6e) border-box;
  box-shadow: inset 0 4rpx 20rpx rgba(255,91,110,.12), 0 12rpx 44rpx rgba(255,91,110,.25);
}
.jar.done {
  background:
    linear-gradient(rgba(255,255,255,.3), rgba(255,255,255,.3)) padding-box,
    linear-gradient(135deg,#2fd99a,#0f8f63) border-box;
  box-shadow: 0 0 30rpx rgba(47,217,154,.4);
}
.jar .fill {
  position: absolute; left: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(91,108,255,.85), rgba(139,151,255,.8));
  transition: height .6s ease-out;
}
.jar.red .fill { background: linear-gradient(180deg, rgba(255,122,136,.85), rgba(255,91,110,.8)); }
.jar .float {
  position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; z-index: 2;
}
.jar .float .n { font-size: 76rpx; font-weight: 900; color: #9a6a00; letter-spacing: 1rpx;
  text-shadow: 0 2rpx 0 rgba(255,235,160,.6), 0 4rpx 16rpx rgba(180,120,0,.25); }
.jar .float .s { font-size: 22rpx; color: #7a7a92; margin-top: 8rpx; font-weight: 500; }
.page.night .jar .float .n { color: #fff; -webkit-text-stroke: 2rpx #d4af37; text-shadow: 0 4rpx 16rpx rgba(200,150,0,.4); }
.page.night .jar .float .s { color: rgba(255,255,255,.85); }

/* 金币下落 */
.coin {
  position: absolute; top: -60rpx; width: 44rpx; height: 44rpx; border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #fff6cf, #ffd24d 55%, #e8a200);
  box-shadow: 0 4rpx 12rpx rgba(180,120,0,.4), inset 0 0 0 4rpx rgba(255,255,255,.5);
  z-index: 6; color: #a8650a; font-size: 22rpx; line-height: 44rpx; text-align: center;
  animation: coinFall 1.1s cubic-bezier(.4,0,.6,1) forwards;
}
@keyframes coinFall {
  0% { transform: translateY(0) rotate(0); opacity: 0; }
  15% { opacity: 1; }
  100% { transform: translateY(400rpx) rotate(320deg); opacity: 0; }
}

/* 统计内页返回 */
.nav-back { font-size: 32rpx; color: var(--blue); font-weight: 600; }
.page.night .nav-back { color: #aab4ff; }

.tip { font-size: 22rpx; color: var(--text-2); font-weight: 500; }
.green-txt { color: var(--green); }
.red-txt { color: var(--red); }
.blue-txt { color: var(--blue); }
.page.night .blue-txt { color: #aab4ff; }
